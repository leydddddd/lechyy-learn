{
  "name": "lechyy",
  "version": "0.1.1",
  "private": true,
  "description": "Chinese Reader Browser Extension — annotate Chinese text with pinyin + on-hover translation",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/placeholder.js && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:dict": "tsx scripts/build-dict.ts"
  },
  "dependencies": {
    "@pinyin-pro/data": "^1.3.1",
    "pinyin-pro": "^3.28.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.9.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-web-extension": "^4.5.1",
    "vitest": "^2.1.5"
  }
}
